{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perelioy-site",
  "account_id": "c0ca52e19d83fb2d94660954f9a32b34",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "perelioy.com",
      "custom_domain": true
    },
    {
      "pattern": "www.perelioy.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
