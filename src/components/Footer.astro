---
import LangSwitch from './LangSwitch.astro';
import { SITE_NAME } from '../site';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-grid footer-grid--archive">
    <div>
      <h2>{SITE_NAME}</h2>
      <p>{t(locale, 'footer.blurb')}</p>
    </div>
    <div>
      <h3>{t(locale, 'footer.language')}</h3>
      <LangSwitch locale={locale} className="footer-lang" />
    </div>
  </div>
  <div class="footer-legal">
    <div class="shell">
      <span>© {new Date().getFullYear()} {SITE_NAME}</span>
      <a href={Astro.site}>{Astro.site?.hostname}</a>
    </div>
  </div>
</footer>
